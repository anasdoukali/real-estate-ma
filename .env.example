# Supabase/PostgreSQL connection string. Keep the real value in .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional but recommended for deployments where database seeding is not run.
# Set these in the host's server-side environment-variable panel, never in a
# NEXT_PUBLIC_* variable. Signing in with these values creates or resets this
# administrator account in the connected database.
ADMIN_BOOTSTRAP_EMAIL=admin@agency.ma
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
ADMIN_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Server-only Supabase Storage credentials. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Create a public bucket named property-images; no public upload policy is needed.
