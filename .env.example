# Supabase/PostgreSQL connection string. Keep the real value in .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Server-only Supabase Storage credentials. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Create a public bucket named property-images; no public upload policy is needed.
